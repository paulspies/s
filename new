# Replace the broken OpenSSH 7.7p1 with the current official Win32-OpenSSH build.
# The old binaries in System32\OpenSSH are left alone; we install alongside and
# repoint the service. Nothing is deleted except the dead service registration.

$ErrorActionPreference = 'Continue'
function Say($m) { Write-Host $m }

if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
      ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "`n  STOP. Not an Administrator window.`n" -ForegroundColor Red
    return
}

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$dest = 'C:\Program Files\OpenSSH'

Say "`n=== Installing current OpenSSH on $env:COMPUTERNAME ==="
Say "    Windows: $((Get-CimInstance Win32_OperatingSystem).Caption) build $([Environment]::OSVersion.Version.Build)`n"

# --- 1. Retire the dead service ---
Say "[1/6] Removing the dead sshd service registration"
foreach ($s in 'sshd','ssh-agent') {
    if (Get-Service $s -ErrorAction SilentlyContinue) {
        Stop-Service $s -Force -ErrorAction SilentlyContinue
        sc.exe delete $s | Out-Null
        Say "      removed $s"
    }
}
Start-Sleep -Seconds 2

# --- 2. Download ---
Say "[2/6] Downloading the current release"
$zip = Join-Path $env:TEMP 'OpenSSH-Win64.zip'
Remove-Item $zip -ErrorAction SilentlyContinue
try {
    Invoke-WebRequest -Uri 'https://github.com/PowerShell/Win32-OpenSSH/releases/latest/download/OpenSSH-Win64.zip' `
        -OutFile $zip -UseBasicParsing
    Say "      got $([math]::Round((Get-Item $zip).Length/1MB,1)) MB"
} catch {
    Say "      DOWNLOAD FAILED: $($_.Exception.Message)"; return
}

# --- 3. Extract ---
Say "[3/6] Extracting to $dest"
if (Test-Path $dest) { Rename-Item $dest "$dest.old-$(Get-Date -Format yyyyMMddHHmmss)" -ErrorAction SilentlyContinue }
Expand-Archive -Path $zip -DestinationPath $env:TEMP -Force
$src = Join-Path $env:TEMP 'OpenSSH-Win64'
if (-not (Test-Path $src)) { Say "      EXTRACT FAILED"; return }
Move-Item $src $dest -Force
Say "      version now: $((Get-Item (Join-Path $dest 'sshd.exe')).VersionInfo.ProductVersion)"

# --- 4. Register the service ---
Say "[4/6] Registering the service"
& (Join-Path $dest 'install-sshd.ps1') | Out-Null
Set-Service sshd -StartupType Automatic
Set-Service ssh-agent -StartupType Automatic

# --- 5. Host keys, permissions, and the authorised key ---
Say "[5/6] Host keys and authorised key"
& (Join-Path $dest 'ssh-keygen.exe') -A | Out-Null

$pub = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINp1BboF98uJXCwLOIexqspee1vWzMidWDFu8sTp6ufz pc2-to-datacenter'
$akf = 'C:\ProgramData\ssh\administrators_authorized_keys'
if (-not (Test-Path 'C:\ProgramData\ssh')) { New-Item -ItemType Directory -Path 'C:\ProgramData\ssh' | Out-Null }
if (-not (Test-Path $akf)) { New-Item -ItemType File -Path $akf | Out-Null }
if ((Get-Content $akf -Raw -ErrorAction SilentlyContinue) -notmatch [regex]::Escape($pub)) {
    Add-Content -Path $akf -Value $pub -Encoding ascii
}
icacls.exe $akf /inheritance:r /grant 'Administrators:F' /grant 'SYSTEM:F' | Out-Null
Get-ChildItem 'C:\ProgramData\ssh\ssh_host_*_key' -ErrorAction SilentlyContinue | ForEach-Object {
    icacls.exe $_.FullName /inheritance:r /grant 'SYSTEM:F' /grant 'Administrators:F' | Out-Null
}

if (-not (Get-NetFirewallRule -Name 'sshd-claude' -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name 'sshd-claude' -DisplayName 'OpenSSH Server (sshd)' `
        -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null
}

# --- 6. Start ---
Say "[6/6] Starting"
Start-Service sshd -ErrorAction SilentlyContinue
Start-Sleep -Seconds 4
$st = (Get-Service sshd -ErrorAction SilentlyContinue).Status

Say "`n============================================"
if ($st -eq 'Running') {
    $ip = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -like '192.168.*' }).IPAddress
    Say "  SUCCESS - sshd is RUNNING"
    Say "  $env:COMPUTERNAME  user $env:USERNAME  at $ip"
    Say "  Tell Claude. Nothing else needed from you."
} else {
    Say "  sshd is: $st"
    Say "  Recent errors:"
    Get-WinEvent -LogName System -MaxEvents 150 -ErrorAction SilentlyContinue |
        Where-Object { $_.Message -match 'sshd|OpenSSH' } | Select-Object -First 3 |
        ForEach-Object { Say "   - $($_.Message)" }
}
Say "============================================`n"
