# OpenSSH 10.0p2 is already extracted to C:\Program Files\OpenSSH.
# It only failed to register because ExecutionPolicy blocked install-sshd.ps1.
# Run that installer with the policy bypassed, then finish the setup.

$ErrorActionPreference = 'Continue'
function Say($m) { Write-Host $m }

if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
      ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "`n  STOP. Not an Administrator window.`n" -ForegroundColor Red
    return
}

$dest = 'C:\Program Files\OpenSSH'
Say "`n=== Registering sshd on $env:COMPUTERNAME ===`n"

if (-not (Test-Path (Join-Path $dest 'sshd.exe'))) {
    Say "  sshd.exe is not in $dest - run the 'new' script first."; return
}
Say "[1/5] Found $((Get-Item (Join-Path $dest 'sshd.exe')).VersionInfo.ProductVersion)"

# --- 2. Register, with the policy bypassed for the installer file ---
Say "[2/5] Registering service (ExecutionPolicy bypassed)"
$inst = Join-Path $dest 'install-sshd.ps1'
& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $inst 2>&1 |
    ForEach-Object { Say "      $_" }

if (-not (Get-Service sshd -ErrorAction SilentlyContinue)) {
    Say "      registration still failed - falling back to sc.exe create"
    sc.exe create sshd binPath= "`"$dest\sshd.exe`"" start= auto DisplayName= "OpenSSH SSH Server" | Out-Null
    sc.exe create ssh-agent binPath= "`"$dest\ssh-agent.exe`"" start= auto DisplayName= "OpenSSH Authentication Agent" | Out-Null
}

if (Get-Service sshd -ErrorAction SilentlyContinue) {
    Set-Service sshd -StartupType Automatic
    Say "      sshd registered"
} else {
    Say "      COULD NOT REGISTER. Stopping here."; return
}
if (Get-Service ssh-agent -ErrorAction SilentlyContinue) { Set-Service ssh-agent -StartupType Automatic }

# --- 3. Host keys ---
Say "[3/5] Host keys"
& (Join-Path $dest 'ssh-keygen.exe') -A 2>&1 | ForEach-Object { Say "      $_" }

# --- 4. Authorised key, permissions, firewall ---
Say "[4/5] Authorised key and permissions"
$pub = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINp1BboF98uJXCwLOIexqspee1vWzMidWDFu8sTp6ufz pc2-to-datacenter'
if (-not (Test-Path 'C:\ProgramData\ssh')) { New-Item -ItemType Directory -Path 'C:\ProgramData\ssh' | Out-Null }
$akf = 'C:\ProgramData\ssh\administrators_authorized_keys'
if (-not (Test-Path $akf)) { New-Item -ItemType File -Path $akf | Out-Null }
if ((Get-Content $akf -Raw -ErrorAction SilentlyContinue) -notmatch [regex]::Escape($pub)) {
    Add-Content -Path $akf -Value $pub -Encoding ascii
}
icacls.exe $akf /inheritance:r /grant 'Administrators:F' /grant 'SYSTEM:F' | Out-Null
Get-ChildItem 'C:\ProgramData\ssh\ssh_host_*_key' -ErrorAction SilentlyContinue | ForEach-Object {
    icacls.exe $_.FullName /inheritance:r /grant 'SYSTEM:F' /grant 'Administrators:F' | Out-Null
}
if (-not (Get-NetFirewallRule -Name 'sshd-claude' -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name 'sshd-claude' -DisplayName 'OpenSSH Server (sshd)' `
        -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null
}
Say "      done"

# --- 5. Start ---
Say "[5/5] Starting"
Start-Service sshd -ErrorAction SilentlyContinue
Start-Sleep -Seconds 5
$st = (Get-Service sshd -ErrorAction SilentlyContinue).Status

Say "`n============================================"
if ($st -eq 'Running') {
    $ip = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -like '192.168.*' }).IPAddress
    Say "  SUCCESS - sshd is RUNNING"
    Say "  $env:COMPUTERNAME   user $env:USERNAME   at $ip"
    Say "  Tell Claude. Nothing else needed from you."
} else {
    Say "  sshd is: $st"
    Get-WinEvent -LogName System -MaxEvents 150 -ErrorAction SilentlyContinue |
        Where-Object { $_.Message -match 'sshd|OpenSSH' } | Select-Object -First 2 |
        ForEach-Object { Say "   - $($_.Message)" }
}
Say "============================================`n"
